{
  "name": "vibesyn",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"NODE_ENV=development bun --watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "worker": "PYTHONPATH=src python task_server.py",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@xyflow/react": "^12.9.3",
    "fflate": "^0.8.2",
    "ketcher-core": "3.12.0",
    "ketcher-react": "3.12.0",
    "ketcher-standalone": "3.12.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "overrides": {
    "ketcher-core": "3.12.0"
  }
}
